rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — anyone authenticated can read any user (needed for partner lookup)
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Bonds (tasks, messages, vision) — accessible if uid is part of the bond id
    match /bonds/{bondId}/{col}/{docId} {
      allow read, write: if request.auth != null && (
        bondId == request.auth.uid ||
        bondId.matches('.*' + request.auth.uid + '.*')
      );
    }

    // Moods — owner can read/write, partner can read non-private
    match /moods/{uid}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && resource.data.isPrivate == false;
    }

    // Habits — owner can read/write, partner can read
    match /habits/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && resource == null
        ? docId.matches(request.auth.uid + '.*')
        : resource.data.userId == request.auth.uid;
    }
  }
}
