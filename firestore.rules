rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Every user's data lives under users/{uid}: the profile document plus the
    // tasks, vision, moods and habits subcollections. Only the signed-in owner
    // can read or write it, so two accounts never see each other's data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
